                </mxCell>
                <mxCell id="flowTableIntro" value="The first five steps happen when a shopper searches. The remaining steps happen in the background to keep the catalog current, enriched and secure." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5E6C84;" vertex="1" parent="1">
