                <mxCell id="securityNote" value="&lt;b&gt;Security posture:&lt;/b&gt; Entra tokens · managed identities · resource-scoped RBAC · private Blob/Cosmos access · local keys disabled" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#44546A;" parent="1" vertex="1">
