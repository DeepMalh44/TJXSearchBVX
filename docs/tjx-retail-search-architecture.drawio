                <mxCell id="flow4Person" value="Receives the best matching products first" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1381" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow4System" value="Azure AI Search filters the catalog, compares words and images, then ranks the strongest matches." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
