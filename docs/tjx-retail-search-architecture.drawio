                <mxCell id="flow2System" value="The FastAPI application receives the request and safely identifies what the person is looking for." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
