                <mxCell id="flowHeadPurpose" value="&lt;b&gt;Why it matters&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#17365D;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
