                <mxCell id="flow4Purpose" value="Results are relevant, fast, and limited to the requested product details." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
