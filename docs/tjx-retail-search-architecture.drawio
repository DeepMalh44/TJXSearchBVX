                <mxCell id="flow10Person" value="Background: the service is operated securely" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E5AF75;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1675" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow10System" value="Managed identities and private connections protect access. Application Insights and Log Analytics record health and activity." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8F0;strokeColor=#E5AF75;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1675" width="760" height="46" as="geometry"/>
                </mxCell>
