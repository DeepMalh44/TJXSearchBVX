                <mxCell id="flow6Person" value="Background: products are loaded or changed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1473" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow6System" value="The ingestion job saves product records in Cosmos DB and original images in private Blob Storage." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1473" width="760" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow6Purpose" value="Cosmos DB remains the trusted product catalog." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="1473" width="400" height="46" as="geometry"/>
