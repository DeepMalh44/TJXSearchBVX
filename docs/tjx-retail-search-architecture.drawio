                <mxCell id="flow5Person" value="Views product details and images" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1427" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow5System" value="The application returns product information from Search and securely retrieves private images from Blob Storage." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1427" width="760" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow5Purpose" value="Images stay private while remaining visible to signed-in users." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="1427" width="400" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow6Step" value="&lt;b&gt;6&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#8BC8AF;fontColor=#256029;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
