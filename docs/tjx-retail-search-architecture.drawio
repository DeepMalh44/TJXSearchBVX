                </mxCell>
                <mxCell id="flow5Step" value="&lt;b&gt;5&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF3FF;strokeColor=#B8CCE4;fontColor=#17365D;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="180" y="1427" width="90" height="46" as="geometry"/>
