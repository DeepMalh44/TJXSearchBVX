                    <mxGeometry x="270" y="1335" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow3System" value="Azure OpenAI understands the words. Azure AI Vision converts an uploaded image into a searchable numeric representation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFE;strokeColor=#B8CCE4;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
