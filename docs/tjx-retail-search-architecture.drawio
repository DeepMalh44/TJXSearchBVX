                <mxCell id="flow7Step" value="&lt;b&gt;7&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CDEBDD;strokeColor=#8BC8AF;fontColor=#256029;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="180" y="1519" width="90" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow7Person" value="Background: Search detects catalog changes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F7F0;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1519" width="390" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow7System" value="Every 15 minutes the Search indexer reads only new or changed product records from Cosmos DB." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F7F0;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1519" width="760" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow7Purpose" value="Only changed products are processed, avoiding unnecessary work." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F7F0;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="1519" width="400" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="flow8Step" value="&lt;b&gt;8&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E0F5;strokeColor=#B49AD3;fontColor=#5B328A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="180" y="1565" width="90" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="flow8Person" value="Background: AI enriches each changed product" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F1FB;strokeColor=#B49AD3;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1565" width="390" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="flow8System" value="The Search skillset calls FastAPI. Microsoft Foundry GPT-5.4-mini creates retail metadata and searchable text; text-embedding-3-small creates the text vector; Azure AI Vision creates the image vector." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F1FB;strokeColor=#B49AD3;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1565" width="760" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="flow8Purpose" value="Products gain consistent categories and meaning-based text/image search." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F1FB;strokeColor=#B49AD3;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="1565" width="400" height="58" as="geometry"/>
                </mxCell>
                <mxCell id="flow9Step" value="&lt;b&gt;9&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DDF4EA;strokeColor=#8BC8AF;fontColor=#256029;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
                    <mxGeometry x="180" y="1623" width="90" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="flow9Person" value="Background: Search publishes the enriched product" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1">
                    <mxGeometry x="270" y="1623" width="390" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="flow9System" value="Search stores the generated metadata, searchable text, and vectors in the V4 index. The original Cosmos DB product record is not changed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="660" y="1623" width="760" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="flow9Purpose" value="Catalog changes become searchable while Cosmos remains the source of truth." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1FAF6;strokeColor=#8BC8AF;fontSize=10;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
                    <mxGeometry x="1420" y="1623" width="400" height="52" as="geometry"/>
